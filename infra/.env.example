# Copy to infra/.env and fill in. That file is gitignored - it holds a credential.
#
#   cp infra/.env.example infra/.env
#   infra/tofu.sh plan
#
# OpenTofu does not read .env itself; tofu.sh parses this and exports it. The TF_VAR_ prefix is
# what maps each line onto the matching variable in variables.tf.
#
# If TF_VAR_linode_token is already exported in your shell, tofu.sh uses that and never reads
# this file - which is the better habit, because it means the token exists in exactly one place
# on disk rather than once per project.

# --- required -------------------------------------------------------------------------------
# cloud.linode.com -> API Tokens -> Create. "Linodes: Read/Write" and "Firewalls: Read/Write"
# is enough; it does not need account-wide access.
TF_VAR_linode_token=

# --- optional (defaults live in variables.tf) -----------------------------------------------
# The witness must NOT be in the same country as the network it watches. A witness that shares
# your upstream corroborates whatever your upstream is doing.
#TF_VAR_region=us-east

# g6-nanode-1 is Linode's smallest, ~$5/mo. Five TLS handshakes every five minutes fit easily.
#TF_VAR_witness_type=g6-nanode-1

# Narrow this to your own address once the box is up.
#TF_VAR_ssh_allow_cidrs=["0.0.0.0/0"]

# LEAVE EMPTY unless overriding: tofu.sh reads your key off disk, trying ~/.ssh/id_ed25519.pub
# then ~/.ssh/id_rsa.pub. Point SSH_PUBLIC_KEY_FILE at another path if yours lives elsewhere.
#SSH_PUBLIC_KEY_FILE=
TF_VAR_ssh_public_key=

# Which addresses may dial the witness port (phase 2). A single /32 is the tightest rule and the
# one that breaks: a residential ISP rotates the sensor's address, and the sensor is then locked
# out of its own witness until someone notices. Allowlist the ISP allocations the line draws
# from instead - larger than one address, far smaller than the internet, and it never goes stale.
# Pinned mutual TLS is the actual authentication; this is defence-in-depth.
#
# Find yours from the sensor, and list every allocation it has been seen in:
#   whois "$(curl -s https://api.ipify.org)" | grep -iE '^(inetnum|netname)'
#
# This file is gitignored. Keep real netblocks here, never in a tracked file.
#TF_VAR_witness_allow_cidrs=["203.0.113.0/24","198.51.100.0/24"]

# Addresses allowed to reach SSH. Keep this TIGHT - a /32 - and recover a rotation through the
# Lish console or one `tofu.sh apply`. sshd is a far more attractive target than a port that
# rejects everyone without a pinned client certificate, so it does not get the same treatment.
#TF_VAR_ssh_allow_cidrs=["203.0.113.9/32"]
